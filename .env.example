# Supabase project (Dashboard → Settings → API / API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key — safe for the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — bypasses RLS. Server-only; never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key. Leave empty to run fully offline: AI features fall back to
# deterministic mocks and PDF extraction uses the key-free local parser.
ANTHROPIC_API_KEY=
# Optional model override; defaults to claude-sonnet-4-6 when unset.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Set to false (with a key present) to enable real AI calls.
AI_MOCK_MODE=true
# Monthly cap on AI calls per teacher (cost control).
AI_MONTHLY_TEACHER_LIMIT=200

# DEV_LOGIN_CODES is intentionally NOT listed here. It is a local-dev-only flag that
# prints login codes on the sign-in screen. Never set it in a deployed environment.

# Comma-separated emails allowed to publish into the SHARED question library at
# /teacher/library. Anything published there is visible to every teacher on the platform,
# so leave this unset unless you mean it — unset denies everyone.
PLATFORM_OWNER_EMAILS=

# Where the landing page's "Tell us what you need" button points — a Google Form, Tally, or
# any feedback link. The button is hidden entirely when this is unset, so the page never
# ships a dead CTA. Public by nature (it is rendered into a static page).
NEXT_PUBLIC_FEEDBACK_URL=
